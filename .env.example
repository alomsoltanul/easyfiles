# ConvertTools — environment template
# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------- supabase
# Project settings -> API. The publishable/anon key is safe in the browser;
# the service-role/secret key must stay server-side only.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------- admin console
# The console is served at /$ADMIN_PATH_SECRET. Keep it out of git, links and
# sitemaps. Rotate it by changing this value — no code changes needed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
ADMIN_PATH_SECRET=""

# Console sign-in runs on NextAuth, entirely separate from customer accounts.
# Required. Generate with: npx auth secret   (or openssl rand -base64 33)
AUTH_SECRET=""

# Optional — enables "Continue with Google" on the console login. The account
# must already exist in admin_users; Google never creates one.
# Authorised redirect URI: https://your-domain/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only needed if the deployment URL cannot be inferred from the request, e.g.
# behind a proxy that rewrites Host. Vercel does not need it.
# AUTH_URL="https://easyheictojpg.vercel.app"

# Create the first console account with:
#   node scripts/create-admin.mjs you@example.com --role owner

# ---------------------------------------------------------------- stripe
# Dashboard -> Developers. Use test keys locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Price IDs, one per plan and interval. Also settable from the admin console.
STRIPE_PRICE_STARTER_MONTH=""
STRIPE_PRICE_STARTER_YEAR=""
STRIPE_PRICE_PRO_MONTH=""
STRIPE_PRICE_PRO_YEAR=""
STRIPE_PRICE_BUSINESS_MONTH=""
STRIPE_PRICE_BUSINESS_YEAR=""

# ---------------------------------------------------------------- cron
# Shared secret for the daily history-retention job (Vercel Cron sends it).
CRON_SECRET=""

# ---------------------------------------------------------------- video tools
# Set on Vercel builds so youtube-dl-exec picks the linux binary.
# YOUTUBE_DL_FILENAME="yt-dlp_linux"

# ---------------------------------------------------------------- ai profile features (optional)
# Powers AI bio generation and creative theme generation for user link pages.
# If omitted, intelligent built-in heuristic generators are used automatically.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
